{
    "name": "editais/proposta-service",
    "description": "Núcleo do domínio de propostas — Clean Architecture + DDD tático + Outbox Pattern",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*",
        "ext-rdkafka": "*",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Migrations\\": "database/migrations/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
