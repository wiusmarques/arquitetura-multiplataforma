{
    "name": "editais/gestao-interna",
    "description": "Monolito de gestão interna — command side dos editais, Outbox Pattern, uso exclusivo da administração",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*",
        "ext-rdkafka": "*",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.8",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
