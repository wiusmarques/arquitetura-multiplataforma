# ============================================================================
# ATENÇÃO — este modelo vem COM credenciais, de propósito.
#
# O `.env` existe aqui apenas para simular o ambiente real com facilidade:
# o avaliador clona o repositório numa máquina limpa e sobe tudo com um
# comando, sem pedir segredo a ninguém. Por isso o `.env.example` é versionado
# já com os valores do laboratório.
#
# Na vida real essas informações NUNCA iriam para o repositório: credenciais
# de banco, senhas de admin e client secrets viveriam em um secret manager
# (Vault, AWS Secrets Manager, GCP Secret Manager) ou em variáveis protegidas
# do CI/CD, injetadas no container em tempo de deploy — e o `.env.example`
# teria apenas as CHAVES, com os valores em branco.
# ============================================================================

# Sem COMPOSE_PROJECT_NAME nem COMPOSE_FILE aqui, de propósito: cada bloco do
# stack é um projeto compose próprio e declara o próprio `name:`
# (`editais-base` e `editais-services`). Definir essas variáveis no .env
# sobrescreveria o `name:` e jogaria os dois blocos de volta num projeto só.

# PostgreSQL (um banco, um schema por serviço — ver docker/postgres/init-schemas.sql)
POSTGRES_USER=editais
POSTGRES_PASSWORD=editais
POSTGRES_DB=editais
POSTGRES_PORT=5432

# Keycloak (simula o Gov.br como Identity Provider)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8089

# Kafka
KAFKA_HOST_PORT=29092
KAFKA_UI_PORT=8090

# Mailpit (simula o servidor de e-mail)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Portas dos serviços da aplicação (host)
GESTAO_PORT=8080
BFF_PORT=8000
EDITAL_PORT=8001
PROPOSTA_PORT=8002
AVALIACAO_PORT=8003
NOTIFICATION_PORT=8004
APP_WEB_PORT=5173

# APP_KEY dos serviços Laravel — chaves de LABORATÓRIO (ver aviso no topo:
# em produção, cada ambiente geraria a sua e guardaria em secret manager).
APP_KEY_GESTAO=base64:0avEtKOjOTuyQHW1XEPihzSvah3JLIsNYXiMPRJJsT0=
APP_KEY_PROPOSTA=base64:xW0lvmCxtiMQTdtrf7FOBiEeXc3+k605aB8jUC00WIQ=
APP_KEY_BFF=base64:OHqW9vVSg+/TADmVvH5GVFkIl00MPZpAxSVqtzILEhs=
