                <mxCell id="mono" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#E8DAF5;fontColor=#3B1D59;strokeColor=#5A2A84;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;gestao-interna (monolito)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[PHP 8.3 / Laravel + Blade — :8080]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ferramenta de uso exclusivo da administracao interna. Command side dos editais: cria, publica e encerra. Atribui avaliadores. Publica eventos via Outbox.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="160" width="330" x="385" y="252" as="geometry"/>
                </mxCell>
                <mxCell id="web" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#D9E8F8;fontColor=#163A5F;strokeColor=#2E6295;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;app-web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[SPA — JS (Vue/React) — :5173]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Portal externo: vitrine de editais, submissão e acompanhamento de propostas e área do avaliador (pareceres).&lt;/font&gt;" vertex="1">
                    <mxGeometry height="160" width="300" x="400" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="mob" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#D9E8F8;fontColor=#163A5F;strokeColor=#2E6295;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;app-mobile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[React Native / Flutter]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Versão mobile: consulta de editais e acompanhamento do status das propostas.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="150" width="300" x="422" y="974" as="geometry"/>
                </mxCell>
                <mxCell id="bff" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#E8DAF5;fontColor=#3B1D59;strokeColor=#5A2A84;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;bff-gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[PHP 8.3 / Laravel — :8000]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ponto de entrada único de web e mobile. Valida JWT (JWKS do Keycloak), agrega edital + proposta, circuit breaker nas chamadas internas.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="170" width="320" x="820" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="edital" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#D9E8F8;fontColor=#163A5F;strokeColor=#2E6295;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;edital-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[Python 3.12 / FastAPI — :8001]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Query side dos editais (CQRS): leitura pública de alto volume. Read model populado pelos eventos do monolito.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="160" width="300" x="830" y="504" as="geometry"/>
                </mxCell>
                <mxCell id="prop" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#E8DAF5;fontColor=#3B1D59;strokeColor=#5A2A84;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;proposta-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[PHP 8.3 / Laravel — :8002]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Núcleo do domínio: submissão e ciclo de vida da proposta. Clean Architecture + DDD (Proposta = Aggregate Root). Outbox Pattern.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="170" width="320" x="1284" y="920" as="geometry"/>
                </mxCell>
                <mxCell id="aval" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#D9E8F8;fontColor=#163A5F;strokeColor=#2E6295;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;avaliacao-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[Python 3.12 / FastAPI — :8003]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Distribui propostas aos avaliadores e registra pareceres. Consome proposta.submetida, publica proposta.avaliada.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="160" width="300" x="1201" y="416" as="geometry"/>
                </mxCell>
                <mxCell id="notif" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#D9E8F8;fontColor=#163A5F;strokeColor=#2E6295;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;notification-service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[Python 3.12 / FastAPI — :8004]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Consumer Kafka de todos os tópicos. Envia e-mails a proponentes e avaliadores.&lt;/font&gt;" vertex="1">
