                <mxCell id="sys" parent="1" style="shape=mxgraph.c4.system;whiteSpace=wrap;html=1;fillColor=#C9DCF4;fontColor=#052E56;strokeColor=#0B4884;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Plataforma de Editais Federais&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Gerencia o ciclo de vida de editais federais: publicação, submissão de propostas, avaliação, resultado e notificações. Expõe API pública de transparência (distribuição de recursos e prestação de contas). Dimensionada para picos de 5.000 acessos/min no encerramento de editais.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="200" width="460" x="560" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="e_idp" parent="1" style="shape=mxgraph.c4.system;whiteSpace=wrap;html=1;fillColor=#E5E7EB;fontColor=#1F2937;strokeColor=#6B7280;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Keycloak (simular govbr)&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Identity Provider. Autentica usuários e emite tokens JWT com roles (OAuth2/OIDC).&lt;/font&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="280" x="160" y="726" as="geometry"/>
                </mxCell>
                <mxCell id="e_mail" parent="1" style="shape=mxgraph.c4.system;whiteSpace=wrap;html=1;fillColor=#E5E7EB;fontColor=#1F2937;strokeColor=#6B7280;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Servidor de E-mail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Notificações de edital, proposta e resultado (Mailpit no laboratório).&lt;/font&gt;" vertex="1">
                    <mxGeometry height="150" width="280" x="511" y="904" as="geometry"/>
                </mxCell>
                <mxCell id="e_rfb" parent="1" style="shape=mxgraph.c4.system;whiteSpace=wrap;html=1;fillColor=#E5E7EB;fontColor=#1F2937;strokeColor=#6B7280;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;API CPF/CNPJ (Receita)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Valida dados cadastrais de PF/PJ. Integração simulada (stub) no laboratório.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="150" width="280" x="834" y="765" as="geometry"/>
                </mxCell>
                <mxCell id="e_transp" parent="1" style="shape=mxgraph.c4.system;whiteSpace=wrap;html=1;fillColor=#E5E7EB;fontColor=#1F2937;strokeColor=#6B7280;strokeWidth=2;fontSize=13;align=center;" value="&lt;b style=&quot;font-size:15px&quot;&gt;Órgãos de Controle e Dados Abertos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Sistemas externos que consomem a API pública de transparência: distribuição de recursos e prestação de contas. Somente leitura, consistência eventual.&lt;/font&gt;" vertex="1">
